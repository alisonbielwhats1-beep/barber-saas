{
  "name": "salon-saas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src prisma scripts --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit --incremental false",
    "check:runtime": "tsx scripts/assert-runtime-contract.ts",
    "db:generate": "prisma generate",
    "db:safety-check": "tsx scripts/assert-safe-database.ts --operation=safety-check",
    "predb:push": "tsx scripts/assert-safe-database.ts --operation=db:push",
    "db:push": "prisma db push",
    "predb:migrate": "tsx scripts/assert-safe-database.ts --operation=db:migrate --destructive",
    "db:migrate": "prisma migrate dev",
    "predb:migrate:deploy": "tsx scripts/assert-safe-database.ts --operation=db:migrate:deploy",
    "db:migrate:deploy": "prisma migrate deploy",
    "predb:seed": "tsx scripts/assert-safe-database.ts --operation=db:seed --destructive",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run src/lib/__tests__/invite-postgres.integration.test.ts",
    "test:appointment-integration": "vitest run src/lib/__tests__/appointment-postgres.integration.test.ts src/lib/__tests__/comanda-postgres.integration.test.ts src/lib/__tests__/public-salon-lock-postgres.integration.test.ts src/lib/__tests__/public-salon-runtime-rls-postgres.integration.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@next/env": "15.5.22",
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@supabase/supabase-js": "^2.110.7",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "lucide-react": "^0.445.0",
    "next": "15.5.22",
    "next-auth": "4.24.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "15.5.22",
    "jsdom": "^26.1.0",
    "postcss": "8.5.25",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion@<=1.1.17": "1.1.18",
    "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
    "nanoid": "3.3.18",
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
