# ─── Ambiente e proteção de banco ───────────────────────────────────────────
# Consulte docs/AMBIENTES.md antes de configurar qualquer destino remoto.
APP_ENV="development"
SUPABASE_PROJECT_REF=""
PRODUCTION_SUPABASE_PROJECT_REF=""

# Deixe vazio normalmente. Seeds destrutivos exigem deliberadamente:
# YES_I_AM_USING_A_DISPOSABLE_DATABASE
ALLOW_DESTRUCTIVE_DB_OPERATIONS=""

# ─── PostgreSQL local de desenvolvimento ────────────────────────────────────
# APP_ENV=development e APP_ENV=test aceitam somente hosts locais.

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/salon_dev"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/salon_dev"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Gere o secret com: openssl rand -base64 32
# Trocar o secret invalida todas as sessões existentes (cookies antigos passam
# a dar JWT_SESSION_ERROR até o usuário logar de novo).
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"
# Em produção precisa ser a URL https real — é ela que define o nome do cookie
# de sessão (__Secure-*) e o middleware depende disso pra validar o login.
NEXTAUTH_URL="http://localhost:3001"

# ─── E-mail transacional (Resend) ──────────────────────────────────────────
# Crie a chave em Resend → API Keys. EMAIL_FROM precisa usar um domínio
# verificado no Resend em produção (ex.: "SalonSaaS <convites@seudominio.com>").
RESEND_API_KEY="re_..."
EMAIL_FROM="SalonSaaS <convites@seudominio.com>"
# Ative somente depois de aplicar/verificar as migrations de convite e
# configurar as duas variáveis acima. Ausente ou diferente de "true" = bloqueado.
EMAIL_INVITES_ENABLED="false"

# ─── Supabase Storage (upload de imagens) ────────────────────────────────────
# Supabase → Settings → API Keys
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_..."
# ⚠️ NUNCA exponha a service role key no client — uso server-side apenas.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ─── Geral ───────────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE="America/Sao_Paulo"

# Obrigatório para /api/cron/reminders. Gere um valor aleatório forte na Vercel.
CRON_SECRET=""

# Rate limiting distribuído (Upstash Redis REST). Sem estas variáveis existe
# apenas fallback local para leituras. Em produção, autenticação e escritas
# sensíveis falham fechadas quando o Redis está ausente ou indisponível.
# A integração nativa Upstash/Vercel injeta KV_REST_API_URL e
# KV_REST_API_TOKEN; o runtime aceita esses aliases com prioridade.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
