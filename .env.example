# ─── Ambiente e proteção de banco ───────────────────────────────────────────
# Consulte docs/AMBIENTES.md antes de configurar qualquer destino remoto.
APP_ENV="development"
SUPABASE_PROJECT_REF=""
PRODUCTION_SUPABASE_PROJECT_REF=""

# Deixe vazio normalmente. Seeds destrutivos exigem deliberadamente:
# YES_I_AM_USING_A_DISPOSABLE_DATABASE
ALLOW_DESTRUCTIVE_DB_OPERATIONS=""

# ─── PostgreSQL local de desenvolvimento ────────────────────────────────────
# APP_ENV=development e APP_ENV=test aceitam somente hosts locais.

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/salon_dev"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/salon_dev"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Gere o secret com: openssl rand -base64 32
# Trocar o secret invalida todas as sessões existentes (cookies antigos passam
# a dar JWT_SESSION_ERROR até o usuário logar de novo).
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"
# Em produção precisa ser a URL https real — é ela que define o nome do cookie
# de sessão (__Secure-*) e o middleware depende disso pra validar o login.
NEXTAUTH_URL="http://localhost:3001"

# ─── E-mail transacional (Resend) ──────────────────────────────────────────
# Crie a chave em Resend → API Keys. EMAIL_FROM precisa usar um domínio
# verificado no Resend em produção (ex.: "SalonSaaS <convites@seudominio.com>").
RESEND_API_KEY="re_..."
EMAIL_FROM="SalonSaaS <convites@seudominio.com>"
# Recuperação de senha por e-mail fica disponível quando RESEND_API_KEY e
# EMAIL_FROM existem. Convites continuam tendo uma ativação separada abaixo.
# Ative convites somente depois de aplicar/verificar suas migrations.
# Ausente ou diferente de "true" = convites bloqueados.
EMAIL_INVITES_ENABLED="false"

# Administração central entre estabelecimentos. Use o e-mail da sua própria
# conta no app; no primeiro acesso a /plataforma/solicitacoes o papel é
# persistido no banco. Separe mais de um e-mail por vírgula.
PLATFORM_ADMIN_EMAILS=""
# Aviso automático, pelo Resend já usado pelo projeto, quando um novo salão
# solicita acesso. Não ativa WhatsApp/SMS nem cria cobrança externa.
PLATFORM_SIGNUP_NOTIFICATIONS_ENABLED="false"
PLATFORM_ADMIN_NOTIFICATION_EMAIL=""
# Ative somente depois de aplicar e verificar a migration 011 no ambiente.
PLATFORM_BILLING_ENABLED="false"

# ─── Supabase Storage (upload de imagens) ────────────────────────────────────
# Supabase → Settings → API Keys
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_..."
# ⚠️ NUNCA exponha a service role key no client — uso server-side apenas.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ─── Geral ───────────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE="America/Sao_Paulo"

# Obrigatório para /api/cron/reminders. Gere um valor aleatório forte na Vercel.
CRON_SECRET=""

# Rate limiting distribuído (Upstash Redis REST). Sem estas variáveis existe
# apenas fallback local para leituras. Em produção, autenticação e escritas
# sensíveis falham fechadas quando o Redis está ausente ou indisponível.
# A integração nativa Upstash/Vercel injeta KV_REST_API_URL e
# KV_REST_API_TOKEN; o runtime aceita esses aliases com prioridade.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Everflare HQ: habilitar apenas depois da migration 020 validada no ambiente.
HQ_ENABLED=false
# Agente Chefe: migration 022 validada + credencial exclusivamente no servidor.
HQ_CHIEF_ENABLED=false
HQ_SUPPORT_ENABLED=false
HQ_CHIEF_MONTHLY_USD=0
OPENAI_API_KEY=""
# Teste interno da Agents API: somente development/test/staging, com HQ ativo.
# Agentes existentes; configurar os IDs exclusivamente no servidor.
HQ_ORCHESTRATOR_ENABLED=false
# Optional ISO expiry, only after explicit authorization: local diagnostic cap 20.
# Ignored outside development, when expired, or more than 24h ahead. Default cap 10.
HQ_ORCHESTRATOR_DIAGNOSTIC_UNTIL=
# Optional 24 only with explicit additional authorization; same local expiry above.
HQ_ORCHESTRATOR_DIAGNOSTIC_LIMIT=
# Explicitly authorized local laboratory allowance, independent of diagnostic expiry.
# Only 50 is accepted; ignored in hosted environments. Does not reset usage.
HQ_ORCHESTRATOR_LOCAL_DAILY_LIMIT=
HQ_ORCHESTRATOR_PROJECT_ID=proj_48Zf5hXOzoiiCnIEJ4Rb3vN4
HQ_TRIAGE_AGENT_ID=agent_e8bd029a1bbd4f43a129bd1be9e23411f21018285a5d431197
HQ_SALES_AGENT_ID=agent_94cacba2c8cc43d491543bcd80b8d72a6e7d011d37a2496fbf
HQ_CUSTOMER_SUCCESS_AGENT_ID=agent_003e550854e0457b8f6dc7f5d66b82a8b6ce8542a2f34a79a4
HQ_PRODUCT_AGENT_ID=agent_352dc832d7e24079bbb810e811388e04582ba235cacc4bdf9a
HQ_OPERATIONS_AGENT_ID=agent_be139647805440a38f7914a389f720e808b9754920c54543a8
HQ_MARKETING_AGENT_ID=agent_75872b8d4b39403fab2edf59ebbbf46cc39b1ea727f5473995
HQ_CHIEF_AGENT_ID=agent_c9d248870db94949a0d23ca65a714d78de7431951c5448b2a8
