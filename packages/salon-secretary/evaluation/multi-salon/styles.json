{
  "version": 1,
  "about": [
    "Evaluation-only register and regional style markers that a scenario generator may add to owner messages without changing their meaning or the oracle. Insertion only: a marker never replaces, removes or reorders a word of the message.",
    "Apply to the rendered text BEFORE the noise generator (agenda-practice-noise.ts may then drop accents, commas and final marks), never to scenarios with noise false, noNoise regions, oracles, clicks or literal cores (cancellation reasons).",
    "One speaker per scenario: pick at most one region group and one register group for all turns of a scenario, at most maxPerMessage markers of a group per message. Emoji and greetings count as registers.",
    "Never inside the spans of neverInside; never directly after a negation, and no marker within two words after a negation (the same rule as the noise generator). Markers tagged neg-sensitive hold an \"é\" and need that check even at a clause boundary. Every marker survives accent stripping: its folded form never becomes another function word (ó, sô, nó and hã are excluded as ACCENT_COLLAPSE).",
    "The noise invariant (noiseViolations) only allows its own vocabulary, so a style layer checks its own invariant: every added word comes from this file, noiseFacts of the message is unchanged and every entity name keeps its count. A temporal-lexeme greeting goes only before the message, as its own sentence, in the first turn.",
    "excluded lists expressions that look like style but change what a correct secretary must do (negation, assent or confirmation, time, correction, discard, uncertainty, entity reference, noun replacement, name collision, priority, article). They belong in explicit scenarios with their own oracle, never in style or noise.",
    "frames rewrite a leading command into a polite or indirect request: only when the message starts with one of verbs.imperative (a nounHomograph only when an article, a name or \"pra\" follows); the rest of the message stays verbatim and later coordinated verbs keep their form, as real owners mix registers."
  ],
  "positions": {
    "start": "before the first word; joiner comma gives \"oxe, cancela ...\" and joiner space gives \"hum cancela ...\"",
    "end": "after the last word, replacing a final mark; joiner comma gives \"... amanhã, visse\"; not after a negation",
    "clause": "at an existing clause boundary (after a comma or a sentence mark) whose next word is a command verb of verbs.imperative (or \"e\" plus such a verb); never before an entity, a number, a negation or an article, so a hesitation never reads as a self-correction (\"a Ana, é… a Bia\")",
    "sentence-before": "own sentence before the message, capitalized, closed by mark: \"Bom dia! cancela ...\"",
    "sentence-after": "own sentence after the message, capitalized, closed by mark: \"... amanhã. Muito obrigada!\""
  },
  "joiners": { "comma": "marker and message separated by a comma", "space": "marker and message separated by a space only (typed fast or dictated)" },
  "turns": {
    "first": "only the first owner message of a conversation (nothing pending: a greeting, or an assent-like marker, cannot be read as confirming a proposal)",
    "say": "any scripted owner message",
    "answer": "a reply to a question of the secretary (short: start or end positions only)"
  },
  "neverInside": ["entity-name", "number", "clock", "date", "weekday-or-relative-day", "preposition-and-object", "negation-scope", "reason-literal", "protected-region"],
  "tagDefinitions": {
    "interjection": "exclamation without content",
    "vocative": "addresses the listener",
    "tag-question": "question tag at the end (\"visse?\", \"né?\")",
    "greeting": "greeting",
    "politeness": "courtesy formula",
    "thanks": "thanks",
    "closing": "sign-off",
    "framing": "announces the request",
    "filler": "discourse filler",
    "hesitation": "speech hesitation",
    "laughter": "typed laughter",
    "abbreviation": "chat abbreviation",
    "emoji": "emoji",
    "possessive-like": "is also a possessive: always keep the comma",
    "lookalike": "shares a prefix with a service word of salon-types.json (e.g. barbaridade and barba): a prefix matcher would misread it",
    "neg-sensitive": "holds \"é\": never within two words after a negation",
    "assent-like": "could be read as agreement: first turn only",
    "temporal-lexeme": "holds a temporal word (dia, tarde, noite): own sentence before the message, first turn only",
    "indirect-question": "request phrased as a question (\"tem como ...?\")"
  },
