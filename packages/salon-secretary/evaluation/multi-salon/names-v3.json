{
 "version": 1,
 "about": [
  "Multi-salon generator name cohort of version three (fourth candidate, backlog section one). Evaluation-only, hand-written common pt-BR names (and names of immigrant origin common in Brazil); no real person, contact or pairing of a name with any other attribute. Runtime code must never read or copy this file.",
  "Same schema and tag rules as names.json. Every name is new: no single name, spelling variant, nickname or surname equals a folded token of names.json, and no token is a person word of the base fixture, the dev batteries, the example bank or the Golden suite (compound names may reuse a first name of names.json in a new combination).",
  "Rotation: the version three generator splits this cohort in two by a seeded hash (never by hand). The HOLDOUT split draws people, nicknames and surnames from the holdout half of this cohort ONLY (the holdout side of names.json was consumed by the second and third multi-salon holdouts and is retired); the DEV split draws from the dev side of names.json plus the dev half of this cohort, minus every name the example bank, the dev batteries or the base fixture show.",
  "Look-alike pairs kept on purpose (within this cohort or against names.json): Anna/Ana, Taís/Thaís, Daniele/Daniela, Adriel/Adriele, Micael/Micaela, Samir/Samira, Paolo/Paulo, Darcy/Darci, Creusa/Cleusa, Eloísa/Heloísa. Never infer gender from a name: the gender tag only picks agreement words of synthetic texts."
 ],
 "tagDefinitions": {
  "f": "feminine",
  "m": "masculine",
  "u": "unisex (used for either gender)",
  "classic": "more common among older generations",
  "modern": "more common among people born this century",
  "accent": "holds a diacritic or cedilla (derived: any combining mark after NFD); accent stripping by the noise generator keeps identity",
  "particle": "holds a particle (da, das, de, do, dos)",
  "compound": "compound given name",
  "gender-trap": "compound whose grammatical gender differs from its first element",
  "tupi": "indigenous (Tupi) origin",
  "english": "English origin or spelling",
  "anglicized": "Brazilian spelling that imitates English",
  "french": "French origin",
  "italian": "Italian origin",
  "german": "German origin",
  "arabic": "Arabic origin",
  "japanese": "Japanese origin",
  "spanish": "Spanish origin",
  "slavic": "Slavic origin",
  "dutch": "Dutch origin",
  "near-temporal": "sounds like or starts like a temporal word (see relatesTo)",
  "word": "is also a common pt-BR word",
  "temporal": "is, or derives from, a temporal word (see relatesTo)",
  "weekday-like": "sounds like a weekday (see relatesTo)",
  "number-like": "is also an ordinal or number word (see relatesTo)",
  "service-like": "is, or starts like, a service word of salon-types.json (see relatesTo)",
  "color": "is also a color word (hair or nail color)",
  "flower": "is also a flower name",
  "gem": "is also a gem name",
  "nature": "is also a nature word",
  "virtue": "is also a virtue word",
  "religious": "Marian or religious name that is also a word",
  "vocative-like": "also used to address someone (\"oi, flor\"): may be read as a vocative instead of a customer",
  "assistant-name": "same as the assistant's name (Luna)",
  "very-common": "among the most frequent Brazilian surnames",
  "nickname": "nickname of one or more formal names",
  "ambiguous": "nickname of more than one formal name of the pools (derived)",
  "truncation": "shortened form (Tati, Rafa)",
  "diminutive": "diminutive suffix (Fabinho, Aninha)",
  "hypocoristic": "irregular familiar form (Zé, Chico, Tião)",
  "reduplication": "doubled syllable (Juju, Dedé)",
  "initials": "initials used as a name (JP)",
  "abbreviation": "abbreviated honorific",
  "familiar": "familiar honorific used with customers (tia, tio)",
  "korean": "Korean origin",
  "chinese": "Chinese origin"
 },
